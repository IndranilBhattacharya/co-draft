PORT=4000
NODE_ENV=development
# Local mongod, or a MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/codraft
# 32+ random chars: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-64-hex-chars-from-the-command-above
# Exact origin of the frontend (used for CORS and the CSRF origin check)
CLIENT_ORIGIN=http://localhost:5173
